# npm refuses to install on a Node outside package.json `engines` -- the image
# build included, because the Dockerfile copies this file before `npm ci`.
# The range is >=24 <25: matrix-appservice-bridge 12 requires Node >=24.
# bridge-runtime.test.js holds the range, this file and the Dockerfile together
# and runs the library on whatever Node runs it; widen the range only after
# `npm run test:image` passes on the new major.
engine-strict=true
