# npm refuses to install on a Node outside package.json `engines` -- the image
# build included, because the Dockerfile copies this file before `npm ci`.
# The range is >=22 <23: nedb (matrix-appservice-bridge's user and room stores)
# calls util.isDate, which Node 23 removed. nedb-compat.test.js measures that
# boundary on every run; widen the range only after it passes on the new major.
engine-strict=true
